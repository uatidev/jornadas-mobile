EXPO_PUBLIC_OCR_SPACE_API_KEY=K84181994588957

# Appwrite Configuration (si no están ya configuradas)
# EXPO_PUBLIC_APPWRITE_ENDPOINT=your_appwrite_endpoint
# EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Solo para scripts administrativos locales. Nunca usar desde la app ni publicar.
# APPWRITE_API_KEY=your_server_api_key
# APPWRITE_BOOTSTRAP_ADMIN_EMAIL=admin@tabasco.gob.mx
# APPWRITE_BOOTSTRAP_ADMIN_PASSWORD=change_me_before_running
# APPWRITE_BOOTSTRAP_ADMIN_NAME=Super Administrador

# Versión que se muestra en Configuración (si no se define, usa la de app.json)
EXPO_PUBLIC_APP_VERSION=1.1.0
